# Environment Configuration
DATABASE_URL=sqlite:///./ls_enabler.db
# For PostgreSQL: postgresql://ls_user:ls_password@localhost:5432/ls_enabler

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_VERSION=v1
API_TITLE=LS ENABLER API
API_DESCRIPTION=Backend API for LS ENABLER Team Operations Dashboard

# Logging
LOG_LEVEL=INFO